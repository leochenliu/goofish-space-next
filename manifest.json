{
  "manifest_version": 3,
  "name": "Goofish 空格翻页",
  "version": "1.5.0",
  "description": "在闲鱼(goofish)搜索页按空格键翻到下一页，替代鼠标点击翻页箭头。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.goofish.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
